# Скопируйте этот файл в .env и при необходимости укажите параметры.
# Файл .env игнорируется git'ом — секреты не попадут в репозиторий.

# Токен Hugging Face (нужен ТОЛЬКО при первом скачивании модели диаризации pyannote)
HF_TOKEN=hf_ваш_токен_здесь

# Локальная языковая модель для конспектирования (Спринт 2, FR-05 / NFR-04.2)
# По умолчанию используется локальная Ollama на 127.0.0.1:11434 и лёгкая модель qwen2.5:3b.
# Также совместимо с любым OpenAI-совместимым API (LM Studio, vLLM, GigaChat, OpenRouter и др.)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# Локальная сетевая изоляция по NFR-04.2 (слушать только 127.0.0.1)
AUDIOANALYTIC_HOST=127.0.0.1
AUDIOANALYTIC_PORT=8000

# Каталог хранения всех файлов внутри папки пользователя ОС (NFR-04.1).
# Если не задан — используется ~/.audioanalytic (C:\Users\<Имя>\.audioanalytic)
# AUDIOANALYTIC_DATA_DIR=

# Подключение к PostgreSQL 15+ (при запуске через Docker Compose заполняется автоматически;
# без Docker локально по умолчанию используется встроенная БД в папке пользователя):
# DATABASE_URL=postgresql+psycopg://audioanalytic:audioanalytic_local@127.0.0.1:5432/audioanalytic
